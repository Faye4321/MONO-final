rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(cid) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/sharedCollections/$(cid)).data.memberUIDs;
    }
    function canAdd(cid) {
      let c = get(/databases/$(database)/documents/sharedCollections/$(cid)).data;
      return member(cid) && (c.ownerUID == request.auth.uid || c.permission == 'everyoneCanAdd');
    }
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // ---- Friends and collector directory (Gladys) ----
    function validHandle(h) {
      return h is string && h.matches('^[a-z0-9._]{3,20}$') && !h.matches('^[.].*|.*[.]$');
    }
    // Public profile: anyone signed in can read it; only the owner writes it.
    // No email or other private fields are allowed in the document.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'handle', 'bio', 'location',
             'objectCount', 'collectionCount', 'publicCollections', 'updatedAt'])
        && validHandle(request.resource.data.handle)
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 2000
        // The handle in the profile must belong to this user (checked after the batch).
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == request.auth.uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // One owner per handle. Changing handle = create the new one, delete the old one.
    match /handles/{handle} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validHandle(handle)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // One document per pair (id = smallerUID_largerUID), so a pair can't have two
    // relationships and a repeated request fails. Only the receiver can accept;
    // either person can delete (decline, cancel, unfriend).
    match /friendships/{pair} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.fromUID == request.auth.uid
        && request.resource.data.toUID != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.toUID in request.resource.data.participants
        && pair == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && request.resource.data.keys().hasOnly(['participants', 'fromUID', 'toUID', 'fromName',
             'fromHandle', 'toName', 'toHandle', 'status', 'createdAt', 'updatedAt']);
      allow update: if signedIn()
        && resource.data.toUID == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'updatedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    match /invites/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && token.size() == 64
        && request.resource.data.keys().hasOnly(['collectionID', 'ownerUID'])
        && request.resource.data.ownerUID == request.auth.uid
        && getAfter(/databases/$(database)/documents/sharedCollections/$(request.resource.data.collectionID)).data.ownerUID == request.auth.uid
        && getAfter(/databases/$(database)/documents/sharedCollections/$(request.resource.data.collectionID)).data.inviteToken == token;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUID == request.auth.uid;
    }
    match /sharedCollections/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUIDs;
      allow create: if signedIn()
        && request.resource.data.ownerUID == request.auth.uid
        && request.resource.data.memberUIDs == [request.auth.uid]
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && request.resource.data.name is string && request.resource.data.name.size() <= 150
        && request.resource.data.permission in ['ownerOnly', 'everyoneCanAdd']
        && request.resource.data.inviteToken is string && request.resource.data.inviteToken.size() == 64
        && request.resource.data.itemIDs == [];
      allow update: if signedIn() && (
        // Existing members can append shared item IDs; item writes have their own authorization.
        (request.auth.uid in resource.data.memberUIDs
          && (resource.data.ownerUID == request.auth.uid || resource.data.permission == 'everyoneCanAdd')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['itemIDs', 'updatedAt'])
          && request.resource.data.itemIDs.hasAll(resource.data.itemIDs))
        ||
        // A joining user must supply the unguessable invitation token, and may only add themself.
        (request.resource.data.joinProof == resource.data.inviteToken
          && exists(/databases/$(database)/documents/invites/$(resource.data.inviteToken))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUIDs', 'memberNames', 'joinProof'])
          && request.resource.data.memberUIDs.toSet() == resource.data.memberUIDs.toSet().union([request.auth.uid].toSet())
          && request.resource.data.memberUIDs.size() <= 50
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.memberNames[request.auth.uid] is string
          && request.resource.data.memberNames[request.auth.uid].size() <= 100)
      );
      allow delete: if signedIn() && resource.data.ownerUID == request.auth.uid;
      match /items/{iid} {
        allow read: if member(cid);
        allow create: if canAdd(cid) && request.resource.data.uploaderUID == request.auth.uid
          && request.resource.data.payload is string && request.resource.data.payload.size() < 400000
          && (!('preview' in request.resource.data) || request.resource.data.preview.size() <= 180000);
        allow update: if canAdd(cid) && resource.data.uploaderUID == request.auth.uid
          && request.resource.data.uploaderUID == resource.data.uploaderUID
          && request.resource.data.payload is string && request.resource.data.payload.size() < 400000
          && (!('preview' in request.resource.data) || request.resource.data.preview.size() <= 180000);
        allow delete: if member(cid) && (resource.data.uploaderUID == request.auth.uid ||
          get(/databases/$(database)/documents/sharedCollections/$(cid)).data.ownerUID == request.auth.uid);
      }
    }
  }
}
